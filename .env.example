# FlowMonk - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# LISTMONK API CONFIGURATION
# =============================================================================
# Full URL to your Listmonk instance (no trailing slash)
LISTMONK_URL=https://your-listmonk-instance.com

# Listmonk admin credentials
LISTMONK_USER=api
LISTMONK_PASS=your_listmonk_api_password

# =============================================================================
# FLOWMONK APP AUTHENTICATION
# =============================================================================
# Basic HTTP auth credentials for the FlowMonk web UI
# Leave empty to disable authentication (not recommended for production)
APP_USER=admin
APP_PASS=your_secure_password

# Display name for the app (shown in header)
APP_NAME=FlowMonk

# Port for local development (default: 8082)
APP_PORT=8082

# =============================================================================
# WEBHOOK SETTINGS
# =============================================================================
# Dry run mode for webhooks: true = verify and transform but don't modify Listmonk
# Useful for testing webhook integration without creating/updating subscribers
WEBHOOK_DRY_RUN=false

# =============================================================================
# DRIP CONTROLLER SETTINGS
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Dry run mode: true = log only, don't send emails or update state
DRY_RUN=false

# No email mode: true = update SQLite state but skip sending emails
# Useful for testing drip logic without sending actual emails
NO_EMAIL=false